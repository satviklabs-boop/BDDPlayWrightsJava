# --- Build output -----------------------------------------------------------
target/
build/
out/
*.class

# --- Secrets ----------------------------------------------------------------
.env
*.local

# --- Test artifacts ---------------------------------------------------------
test-results/
playwright-report/
*.png
*.zip
*.webm

# Extent Reports output lives under target/extent-report/ and target/retry/,
# both of which are already covered by the target/ rule above.

# --- IDE --------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
# Ignore the contents of .vscode EXCEPT settings.json, which carries the
# shared Cucumber step-definition navigation config (cucumber.glue).
#
# NOTE: the pattern is ".vscode/*" and not ".vscode/". With the trailing-slash
# form git excludes the directory itself and cannot re-include a file inside
# it, so the "!settings.json" negation below would silently do nothing.
.vscode/*
!.vscode/settings.json
.settings/
.classpath
.project

# --- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Logs -------------------------------------------------------------------
*.log

# --- Local scratch / tooling ------------------------------------------------
# Editor backups, captured process exit codes, and locally-injected toolchains
# (e.g. a downloaded Maven distribution) are not part of the project source.
*.bak
*.exit
.tools/
