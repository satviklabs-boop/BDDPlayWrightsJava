# ---------------------------------------------------------------------------
# Copy this file to .env and adjust. (.env is git-ignored.)
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# Anything set here overrides src/test/resources/config.properties.
# Never commit real credentials.
# ---------------------------------------------------------------------------

ENV=dev

# --- UI (login) -------------------------------------------------------------
BASE_URL=https://the-internet.herokuapp.com
UI_USERNAME=tomsmith
UI_PASSWORD=SuperSecretPassword!

# --- API --------------------------------------------------------------------
# jsonplaceholder: no API key, no daily quota - the suite is green out of the box.
# reqres.in is richer but caps anonymous traffic at 40 requests/day per IP.
API_BASE_URL=https://jsonplaceholder.typicode.com
API_KEY=
API_USERNAME=eve.holt@reqres.in
API_PASSWORD=cityslicka

# --- Execution --------------------------------------------------------------
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=30000
API_TIMEOUT=60000
ARTIFACT_DIR=target/artifacts

# --- Retry analyser ---------------------------------------------------------
# Failed scenarios are re-run automatically so a genuine defect is separated
# from a flaky one. See the "Retry analyser" section of the README.
RETRY_ENABLED=true
# Extra attempts per failed scenario. 0 disables retrying.
RETRY_MAX_ATTEMPTS=1
# Scenarios tagged with this are never retried.
RETRY_TAG_EXCLUDE=@no-retry
RETRY_REPORT_DIR=target/retry
