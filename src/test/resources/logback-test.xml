<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Framework logs at INFO so scenario flow is visible in CI output. -->
    <logger name="com.satviklabs" level="INFO"/>
    <logger name="com.microsoft.playwright" level="WARN"/>
    <logger name="io.cucumber" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
