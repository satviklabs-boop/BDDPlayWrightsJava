# Normalise line endings so the repo is consistent across Windows, macOS and Linux.
# Files are stored with LF in the repository; checked out per-platform.
* text=auto eol=lf

# Windows-only helpers must keep CRLF to run correctly.
*.cmd text eol=crlf
*.bat text eol=crlf

# Shell scripts must stay LF.
*.sh text eol=lf
*.ps1 text eol=lf

# Binary artifacts Git should never try to diff or convert.
*.png binary
*.jpg binary
*.zip binary
*.jar binary
*.webm binary
