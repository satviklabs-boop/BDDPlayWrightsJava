<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.satviklabs</groupId>
    <artifactId>playwright-java-bdd</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>PlayWrightJava</name>
    <description>BDD Playwright test automation framework in Java - UI login and API testing</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <playwright.version>1.63.0</playwright.version>
        <cucumber.version>7.20.1</cucumber.version>
        <testng.version>7.10.2</testng.version>
        <surefire.version>3.6.0</surefire.version>
        <assertj.version>3.26.3</assertj.version>
        <slf4j.version>2.0.16</slf4j.version>
        <logback.version>1.5.12</logback.version>
        <dotenv.version>3.0.0</dotenv.version>
        <gson.version>2.11.0</gson.version>
        <!-- Empty means "run all scenarios". Override with -Dcucumber.filter.tags="@smoke". -->
        <cucumber.filter.tags></cucumber.filter.tags>
        <!-- Retry: run failed scenarios again before declaring a failure. -->
        <RETRY_ENABLED>true</RETRY_ENABLED>
        <RETRY_MAX_ATTEMPTS>1</RETRY_MAX_ATTEMPTS>
        <RETRY_TAG_EXCLUDE>@no-retry</RETRY_TAG_EXCLUDE>
        <!-- Extent Reports: rich HTML dashboard, driven by the Cucumber 7 adapter. -->
        <extentreports.version>5.1.1</extentreports.version>
        <extentreports.adapter.version>1.14.0</extentreports.adapter.version>
    </properties>

    <dependencies>
        <!-- Playwright: browser automation + APIRequestContext -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <!-- Cucumber-JVM: BDD layer (Gherkin) -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Dependency injection for step definitions (constructor injection) -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-picocontainer</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-testng</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
          TestNG drives the Cucumber suite. Chosen over the JUnit Platform
          because IRetryAnalyzer gives us in-process scenario retry that
          Surefire's rerunFailingTestsCount cannot provide for Cucumber.
        -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
          Surefire picks exactly ONE provider, and it must be the NATIVE TestNG
          provider.

          Do NOT add junit-jupiter or org.junit.support:testng-engine back:

          * With JUnit on the classpath Surefire auto-selects the JUnit Platform
            provider, and the Cucumber suite is silently SKIPPED - zero
            scenarios, no error.
          * With testng-engine (the JUnit-bridge for TestNG) the suite IS
            discovered but every scenario is silently skipped, because
            AbstractTestNGCucumberTests.scenarios() returns an empty array when
            its runner is null - and the JUnit Platform evaluates data providers
            at DISCOVERY time, before the @BeforeClass that builds that runner.
            Symptom: "data provider 'scenarios' returned an empty array".

          Only the native TestNG provider runs @BeforeClass before the data
          provider, which is what cucumber-testng requires.
        -->

        <!--
          JUnit has been removed entirely. It must NOT come back (directly or
          transitively): with JUnit on the test classpath Surefire selects the
          JUnit Platform provider, and the Cucumber/TestNG suite is then
          silently skipped. The unit tests in com.satviklabs.routine are
          TestNG tests now for exactly that reason.
        -->

        <!-- Fluent assertions -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Environment configuration via .env -->
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>${dotenv.version}</version>
        </dependency>

        <!-- JSON parsing for API response bodies -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- Extent Reports: the HTML dashboard itself -->
        <dependency>
            <groupId>com.aventstack</groupId>
            <artifactId>extentreports</artifactId>
            <version>${extentreports.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
          Official Cucumber 7 adapter. Registering its plugin class in the
          Cucumber plugin list is all that is needed - it writes the ExtentReport
          from the Gherkin events, so there is no custom listener code to keep
          in sync when Cucumber changes.
        -->
        <dependency>
            <groupId>tech.grasshopper</groupId>
            <artifactId>extentreports-cucumber7-adapter</artifactId>
            <version>${extentreports.adapter.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
          The per-page locator CSVs live in src/test/resources/locators/ - a
          Maven default resource root - and src/test/resources is the default
          test resource root. Both are copied onto the classpath automatically,
          so no custom <resources> or <testResources> entries are needed.
        -->

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <!--
                      Two kinds of tests share the "test" phase: the TestNG-driven
                      Cucumber suite, and the plain Jupiter unit tests in
                      com.satviklabs.routine. Both are included; Surefire runs
                      each under its own engine, so they coexist.
                    -->
                    <includes>
                        <include>**/RunCucumberTest.java</include>
                        <include>**/routine/*Test.java</include>
                    </includes>
                    <!--
                      TestNG reads its options from the @CucumberOptions
                      annotation, not from JUnit configuration parameters, so
                      the tag filter is forwarded as a plain system property
                      here. ConfigLoader-style resolution means an empty
                      default means "run everything".
                    -->
                    <!--
                      Cucumber's TestNG runner does NOT read a JUnit
                      configuration parameter. It resolves the tag filter from
                      the plain system property "cucumber.filter.tags", so that
                      is what has to be forwarded to the forked JVM here.
                      The retry settings are forwarded alongside it so
                      RETRY_MAX_ATTEMPTS can be overridden on the command line.
                    -->
                    <systemPropertyVariables>
                        <cucumber.filter.tags>${cucumber.filter.tags}</cucumber.filter.tags>
                        <RETRY_ENABLED>${RETRY_ENABLED}</RETRY_ENABLED>
                        <RETRY_MAX_ATTEMPTS>${RETRY_MAX_ATTEMPTS}</RETRY_MAX_ATTEMPTS>
                        <RETRY_TAG_EXCLUDE>${RETRY_TAG_EXCLUDE}</RETRY_TAG_EXCLUDE>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <includes>
                        <include>**/RunCucumberTest.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn test -Psmoke : only @smoke scenarios -->
        <profile>
            <id>smoke</id>
            <properties>
                <cucumber.filter.tags>@smoke</cucumber.filter.tags>
            </properties>
        </profile>

        <!-- mvn test -Pregression : only @regression scenarios -->
        <profile>
            <id>regression</id>
            <properties>
                <cucumber.filter.tags>@regression</cucumber.filter.tags>
            </properties>
        </profile>

        <!-- mvn test -Pui : only UI scenarios -->
        <profile>
            <id>ui</id>
            <properties>
                <cucumber.filter.tags>@ui</cucumber.filter.tags>
            </properties>
        </profile>

        <!-- mvn test -Papi : only API scenarios -->
        <profile>
            <id>api</id>
            <properties>
                <cucumber.filter.tags>@api</cucumber.filter.tags>
            </properties>
        </profile>

        <!--
          Retry no longer needs its own profile: TestNG retries failed
          scenarios in-process on every run, controlled by
          RETRY_MAX_ATTEMPTS (default 1, meaning one extra attempt).

            mvn test -DRETRY_MAX_ATTEMPTS=2
            mvn test -DRETRY_ENABLED=false
        -->
    </profiles>
</project>




