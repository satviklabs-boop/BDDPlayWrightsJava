<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.satviklabs</groupId>
    <artifactId>playwright-java-bdd</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>PlayWrightJava</name>
    <description>BDD Playwright test automation framework in Java - UI login and API testing</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <playwright.version>1.63.0</playwright.version>
        <cucumber.version>7.20.1</cucumber.version>
        <junit.platform.version>1.11.3</junit.platform.version>
        <junit.jupiter.version>5.11.3</junit.jupiter.version>
        <surefire.version>3.5.2</surefire.version>
        <assertj.version>3.26.3</assertj.version>
        <slf4j.version>2.0.16</slf4j.version>
        <logback.version>1.5.12</logback.version>
        <dotenv.version>3.0.0</dotenv.version>
        <gson.version>2.11.0</gson.version>
        <!-- Empty means "run all scenarios". Override with -Dcucumber.filter.tags="@smoke". -->
        <cucumber.filter.tags></cucumber.filter.tags>
        <!-- Retry analyser: run failed scenarios again before declaring a failure. -->
        <RETRY_ENABLED>true</RETRY_ENABLED>
        <RETRY_MAX_ATTEMPTS>1</RETRY_MAX_ATTEMPTS>
        <RETRY_TAG_EXCLUDE>@no-retry</RETRY_TAG_EXCLUDE>
        <RETRY_REPORT_DIR>target/retry</RETRY_REPORT_DIR>
        <exec-maven-plugin.version>3.5.0</exec-maven-plugin.version>
        <!-- Extent Reports: rich HTML dashboard, driven by the Cucumber 7 adapter. -->
        <extentreports.version>5.1.1</extentreports.version>
        <extentreports.adapter.version>1.14.0</extentreports.adapter.version>
    </properties>

    <dependencies>
        <!-- Playwright: browser automation + APIRequestContext -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <!-- Cucumber-JVM: BDD layer (Gherkin) -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Dependency injection for step definitions (constructor injection) -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-picocontainer</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 Platform + Jupiter -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <version>${junit.platform.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Fluent assertions -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Environment configuration via .env -->
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>${dotenv.version}</version>
        </dependency>

        <!-- JSON parsing for API response bodies -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- Extent Reports: the HTML dashboard itself -->
        <dependency>
            <groupId>com.aventstack</groupId>
            <artifactId>extentreports</artifactId>
            <version>${extentreports.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
          Official Cucumber 7 adapter. Registering its plugin class in the
          Cucumber plugin list is all that is needed - it writes the ExtentReport
          from the Gherkin events, so there is no custom listener code to keep
          in sync when Cucumber changes.
        -->
        <dependency>
            <groupId>tech.grasshopper</groupId>
            <artifactId>extentreports-cucumber7-adapter</artifactId>
            <version>${extentreports.adapter.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
          The per-page locator CSVs live in src/main/resources/locators/ - a
          Maven default resource root - and src/test/resources is the default
          test resource root. Both are copied onto the classpath automatically,
          so no custom <resources> or <testResources> entries are needed.
        -->

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <includes>
                        <include>**/RunCucumberTest.java</include>
                    </includes>
                    <!--
                      Cucumber's JUnit Platform engine reads its settings as JUnit
                      configuration parameters, not as plain system properties.
                      Passing -Dcucumber.filter.tags through here makes the tag
                      filter actually apply to the suite. The property defaults to
                      empty, which means "run everything".
                    -->
                    <properties>
                        <configurationParameters>
                            cucumber.filter.tags=${cucumber.filter.tags}
                        </configurationParameters>
                    </properties>
                    <!--
                      Forward the retry settings to the forked JVM. ConfigLoader
                      reads system properties first, so these win over .env and
                      config.properties and can be overridden with -DRETRY_MAX_ATTEMPTS=2.
                    -->
                    <systemPropertyVariables>
                        <RETRY_ENABLED>${RETRY_ENABLED}</RETRY_ENABLED>
                        <RETRY_MAX_ATTEMPTS>${RETRY_MAX_ATTEMPTS}</RETRY_MAX_ATTEMPTS>
                        <RETRY_TAG_EXCLUDE>${RETRY_TAG_EXCLUDE}</RETRY_TAG_EXCLUDE>
                        <RETRY_REPORT_DIR>${RETRY_REPORT_DIR}</RETRY_REPORT_DIR>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <includes>
                        <include>**/RunCucumberTest.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn test -Psmoke : only @smoke scenarios -->
        <profile>
            <id>smoke</id>
            <properties>
                <cucumber.filter.tags>@smoke</cucumber.filter.tags>
            </properties>
        </profile>

        <!-- mvn test -Pregression : only @regression scenarios -->
        <profile>
            <id>regression</id>
            <properties>
                <cucumber.filter.tags>@regression</cucumber.filter.tags>
            </properties>
        </profile>

        <!-- mvn test -Pui : only UI scenarios -->
        <profile>
            <id>ui</id>
            <properties>
                <cucumber.filter.tags>@ui</cucumber.filter.tags>
            </properties>
        </profile>

        <!-- mvn test -Papi : only API scenarios -->
        <profile>
            <id>api</id>
            <properties>
                <cucumber.filter.tags>@api</cucumber.filter.tags>
            </properties>
        </profile>

        <!--
          mvn -Pretry test : run the suite with the retry analyser enabled.

          Failed scenarios are re-run up to RETRY_MAX_ATTEMPTS extra times.
          A scenario that passes on a retry is reported as FLAKY; one that never
          passes still fails the build. Retry artefacts land in target/retry/.

          Override on the command line, e.g.:
            mvn -Pretry test -DRETRY_MAX_ATTEMPTS=2
            mvn -Pretry test "-Dcucumber.filter.tags=@regression"
        -->
        <profile>
            <id>retry</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-maven-plugin.version}</version>
                        <configuration>
                            <mainClass>com.satviklabs.runner.RetrySuiteRunner</mainClass>
                            <classpathScope>test</classpathScope>
                            <!--
                              RetrySuiteRunner forks Maven itself, so it must run
                              out-of-process: exec:java would share this JVM's
                              state and the nested build could not start cleanly.
                            -->
                            <executable>mvn</executable>
                            <arguments>
                                <argument>test</argument>
                                <argument>-Dretry.rerun=false</argument>
                            </arguments>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skipTests>true</skipTests>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>




